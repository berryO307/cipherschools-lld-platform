# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/lld_practice?sslmode=require

# Port for the Express server
PORT=4000

# LLM provider key used by LLMEvaluator (Gemini API - https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend origin allowed by CORS (set to the deployed Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Max POST /api/attempts submissions allowed per client per 15-minute window
SUBMIT_RATE_LIMIT=5
